<Page x:Class="IntegradorP.Estoque"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IntegradorP"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Estoque">

    <Grid>
        <Viewbox Stretch="Fill">
            <Grid Width="800" Height="600">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Image Source="/Estoque.jpg" Stretch="Fill"/>
                <Button Content="Button" HorizontalAlignment="Left" Margin="5,559,0,0" VerticalAlignment="Top" Height="37" Width="29" Opacity="0" Click="Button_Click"/>
                <Button Content="CAR" HorizontalAlignment="Left" Margin="728,16,0,0" VerticalAlignment="Top" Height="47" Width="44" Opacity="0" Click="CAR_Click"/>
                <ComboBox x:Name="cbItems" HorizontalAlignment="Left" Margin="61,162,0,0" VerticalAlignment="Top" Width="689" Height="33">
                    <ComboBoxItem Content="Sapato"/>
                    <ComboBoxItem Content="Moletom"/>
                    <ComboBoxItem Content="Oculos"/>
                    <ComboBoxItem Content="Relógio"/>
                </ComboBox>
                <TextBox x:Name="tbQT" HorizontalAlignment="Left" Margin="319,410,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="143" Height="28" FontSize="20" TextAlignment="Center" FontWeight="Bold"/>
                <Button x:Name="btCadastrar" Content="Cadastrar" HorizontalAlignment="Left" Margin="319,449,0,0" VerticalAlignment="Top" Click="btCadastrar_Click" Height="55" Width="143" FontSize="20" FontWeight="Bold"/>
            </Grid>
        </Viewbox>
    </Grid>
</Page>
